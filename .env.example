# WalletConnect Project ID (obtain from https://dashboard.reown.com)
VITE_WALLETCONNECT_PROJECT_ID=

# API URLs
VITE_API_URL_FETCHX=

# Google Analytics Measurement ID (for example, G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Metadata: Read
# Contents: Read & write
# Enable Device Flow
# Enable “Request user authorization (OAuth) during installation”
# Used for connecting and syncing existing repositories.
VITE_GITHUB_SYNC_CLIENT_ID=
VITE_GITHUB_SYNC_APP_SLUG=fetchx-sync

# Metadata: Read
# Contents: Read & write
# Administration: Read & write
# Enable Device Flow
# Enable “Request user authorization (OAuth) during installation”
# Used only when users create personal or organization repositories.
VITE_GITHUB_CREATE_CLIENT_ID=
VITE_GITHUB_CREATE_APP_SLUG=fetchx-create