{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fetchx-desktop-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-19",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "updates.fetchx.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "UPDATE_CHANNEL": "stable"
  },
  "r2_buckets": [
    {
      "binding": "DESKTOP_RELEASES",
      "bucket_name": "fetchx-desktop-releases"
    }
  ],
  "observability": {
    "enabled": true
  }
}
