{
  "name": "fetchx",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "convention:check": "bun run scripts/code-convention-check.ts",
    "convention:strict": "bun run scripts/code-convention-check.ts --strict",
    "format": "biome format --write .",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --config src-tauri/tauri.local.conf.json",
    "desktop:release": "bun run scripts/desktop-release.ts",
    "desktop:version": "bun run scripts/desktop-version.ts",
    "desktop:local:build": "bun run scripts/desktop-local-release.ts build",
    "desktop:local:build:macos": "bun run scripts/desktop-local-release.ts build-macos",
    "desktop:local:build:windows": "bun run scripts/desktop-local-release.ts build-windows",
    "desktop:local:publish": "bun run scripts/desktop-local-release.ts publish",
    "desktop:updates:dev": "wrangler dev --config infrastructure/desktop-updates/wrangler.jsonc",
    "desktop:updates:deploy": "wrangler deploy --config infrastructure/desktop-updates/wrangler.jsonc"
  },
  "dependencies": {
    "@heroui/react": "3.1.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-router": "1.170.10",
    "@tanstack/router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.168.13",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@wagmi/connectors": "8.0.15",
    "@walletconnect/ethereum-provider": "2.23.9",
    "framer-motion": "12.40.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0",
    "viem": "2.52.0",
    "wagmi": "3.6.16",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tauri-apps/cli": "2.11.3",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "6.0.2",
    "vite": "8.0.16",
    "wrangler": "4.107.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "qr": "0.5.5",
    "vite": "8.0.16",
    "ws": "8.21.0"
  },
  "resolutions": {
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "qr": "0.5.5",
    "vite": "8.0.16",
    "ws": "8.21.0"
  }
